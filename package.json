{
  "name": "tunnel-manager",
  "description": "Graphical interface for exposing localhost to the world",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liidioteee/TunnelManager.git"
  },
  "author": "Liidioteee",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test-e2e/**/*.e2e.js\"",
    "build": "electron-builder",
    "prepare": "node scripts/install-git-hooks.js"
  },
  "dependencies": {
    "debug": "^4.3.2",
    "electron-store": "^11.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.tunnel.manager",
    "productName": "Tunnel Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "**/*",
      "!test/**",
      "!test-e2e/**",
      "!scripts/**",
      "!.githooks/**",
      "!.github/**",
      "!eslint.config.js"
    ]
  }
}
